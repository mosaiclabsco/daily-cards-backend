# Copie para .env.local. Valores do projeto Supabase (Settings > API).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Backend Next.js (exclusão de conta). Ex.: http://192.168.0.10:3000 no aparelho, ou o domínio da Vercel.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
# Páginas públicas (termos, privacidade, como revisamos). Vazio esconde os links em Ajustes.
EXPO_PUBLIC_SITE_URL=
